{
  "name": "product-lifecycle-os",
  "productName": "Product Lifecycle OS",
  "version": "0.1.1",
  "description": "产品生命周期执行与决策工具",
  "main": "out/main/index.js",
  "author": "Product Lifecycle OS",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:portable": "electron-vite build && electron-builder --win portable --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.8.69",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8",
    "vite": "^6.0.11",
    "zustand": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
